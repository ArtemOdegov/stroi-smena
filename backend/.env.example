DATABASE_URL="postgresql://corp:corp@localhost:5432/corp?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret"
REDIS_URL="redis://localhost:6379"

# MinIO: Nest ходит по INTERNAL; presigned URL и public URL для телефона — авто с LAN-IP,
# если не заданы S3_PRESIGN_ENDPOINT / S3_PUBLIC_BASE_URL (см. resolvePresignEndpoint).
S3_INTERNAL_ENDPOINT="http://127.0.0.1:9000"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="corp-uploads"

# Опционально (прод / нестандартный хост):
# S3_PRESIGN_ENDPOINT="https://minio.example.com"
# S3_PUBLIC_BASE_URL="https://minio.example.com/corp-uploads"
